# Settings of the API. Copy this file to .env and fill it in; a variable set in the
# environment wins over the file. Never commit .env.
#
# docker compose passes this file to the container (env_file). Its parser strips quotes
# and expands ${...}, so write every value bare: no quotes and no $ (the key and a code
# made as shown below never contain them). One more variable is read by docker compose
# itself, not by the app: HOST_PORT, the port on 127.0.0.1 the app is published on
# (default 8000), e.g.
#   HOST_PORT=8080

# Required. The OpenRouter API key every model request is sent with.
OPENROUTER_API_KEY=

# The access code every request to /invoices must carry, as the header
# "Authorization: Bearer <code>". Set it for anything reachable from outside: everyone
# who has it sees every uploaded document. At least 16 characters of printable ASCII
# without spaces; make one with
#   python3 -c "import secrets; print(secrets.token_urlsafe(24))"
# Empty: no check (local development only; the server logs a warning at start-up).
ACCESS_CODE=

# The largest file an upload may carry, in bytes (10 MB; the multipart envelope around the
# file is not counted). A larger upload is refused with 413.
MAX_FILE_BYTES=10485760
# The most pages a PDF may have; a longer one is refused with 422 too_many_pages.
MAX_PAGES=50
# The most pixels an image may have (width x height); a larger one is refused with 422.
# A page of a scan whose images hold more is not read (the page gets an issue).
MAX_IMAGE_PIXELS=50000000

# How many documents may be waiting or being read at once; one more upload is refused
# (503, try again later). Each waiting document holds its file in memory.
MAX_DOCUMENTS=10
# Of those, how many are read at the same time; the others wait in the queue.
READING_AT_ONCE=3
# Model requests in flight at once, shared by every document being read.
MODEL_REQUESTS_IN_FLIGHT=24
# Seconds one document may take, counted from the moment its reading starts (time in the
# queue does not count). When it passes, what was read so far is kept.
DEADLINE_S=240
# How many documents the process keeps, with their files; older finished ones are
# dropped. Must not be smaller than MAX_DOCUMENTS. A restart loses them all.
# Each kept document holds its file in memory (up to MAX_FILE_BYTES): for a public
# instance in the 1.5 GiB container, keep fewer, e.g. JOBS_KEPT=20.
JOBS_KEPT=50

# The models, as OpenRouter names them. PAGE_MODEL reads every page (a page that fails its
# checks is read once more by the same model); HEADER_MODEL reads the header and totals;
# LAYOUT_MODEL describes the table of a PDF that has a text layer.
PAGE_MODEL=google/gemini-3.1-flash-lite
HEADER_MODEL=google/gemini-3.1-flash-lite
LAYOUT_MODEL=google/gemini-3.1-flash-lite

# Off by default (empty): scans are read once. When it names a model, every page of a scan
# (a PDF without a text layer of its own) is also read by it, through OpenRouter as well,
# and a line item the two models read differently gets an issue with the other model's
# values as a suggestion; the result keeps the first reading. It adds about 40 % to the
# cost of reading a scan and a few seconds; the README says why it is off. To switch it on:
#   SECOND_READING_MODEL=openai/gpt-6-luna
SECOND_READING_MODEL=
